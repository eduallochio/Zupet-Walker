{
  "expo": {
    "name": "Zupet Walker",
    "slug": "zupet-walker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/master-1024.png",
    "userInterfaceStyle": "automatic",
    "scheme": "zupet-walker",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "io.zupet.walker",
      "buildNumber": "1"
    },
    "android": {
      "package": "io.zupet.walker",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/simbolo-branco-transparente.png",
        "backgroundColor": "#00C6A7"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single-page",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "O Zupet Walker usa sua localização para registrar o trajeto dos passeios.",
          "locationAlwaysPermission": "O Zupet Walker usa sua localização em segundo plano durante passeios ativos.",
          "locationWhenInUsePermission": "O Zupet Walker usa sua localização para registrar o trajeto dos passeios."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#00C6A7"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}
